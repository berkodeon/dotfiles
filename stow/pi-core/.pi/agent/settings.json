{
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "externalEditor": "nvim",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "subagents": {
    "defaultModel": "openai-codex/gpt-6.1-sol",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "systemPromptMode": "append"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "systemPromptMode": "append"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "systemPromptMode": "append",
        "inheritSkills": false,
        "skills": ["ponytail"]
      },
      "delegate": {
        "inheritSkills": false,
        "skills": ["ponytail"]
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "systemPromptMode": "append",
        "defaultContext": "fresh",
        "inheritSkills": false,
        "skills": ["ponytail-review"]
      },
      "oracle": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "high",
        "systemPromptMode": "append"
      }
    }
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "packages": [
    "npm:pi-claude-bridge@0.9.1",
    "npm:pi-tab-spinner@0.1.0",
    "npm:@ff-labs/pi-fff",
    "npm:pi-subagents@0.79.2",
    "npm:pi-web-access@0.43.0",
    "npm:@dietrichgebert/ponytail@5.3.2",
    "npm:@mrclrchtr/supi-context",
    "npm:pi-intercom",
    "npm:pi-btw"
  ],
  "lastChangelogVersion": "1.0.1"
}